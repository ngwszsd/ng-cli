{
  "name": "ng-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ng-cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "build:js": "pnpm run typecheck && node esbuild.config.mjs",
    "build": "pnpm run build:js && bun build --compile dist/cli.js --outfile release/ng-cli",
    "start": "node dist/cli.js",
    "test": "pnpm run build && node --import tsx --test test/*.test.ts",
    "release": "bash scripts/release.sh",
    "prepack": "pnpm run build:js"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react-devtools-core": "^6.1.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
